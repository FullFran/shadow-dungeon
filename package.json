{
  "name": "mazmorra-sombria",
  "version": "0.12.1",
  "description": "Non-commercial Pokémon fan game: souls-like top-down combat prototype (M0).",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:proofs": "PROOFS=1 vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "balance": "vite-node tools/balance.ts",
    "prove": "vite-node tools/prove.ts",
    "deploy:preprod": "bash scripts/deploy-preprod.sh"
  },
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "private": true,
  "dependencies": {
    "@clerk/clerk-js": "6.42.1",
    "trystero": "^0.26.0"
  }
}
