# Copy to .env.local for local development (Vite reads it; never commit secrets here).
# Accounts API base URL. Unset = https://sd-api.fullfran.com (production; its CORS only allows the published site).
# Local backend: from server/, `go run . serve --http=127.0.0.1:8090 --origins=http://localhost:5173`
VITE_API_URL=http://127.0.0.1:8090
