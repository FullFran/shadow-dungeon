# Shadow Dungeon API environment. Copy to .env and fill in; never commit .env.

# 32 characters; encrypts the stored settings (OAuth2 client secrets).
# Generate with: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Comma-separated CORS origins (default: https://www.fullfran.com,http://localhost:5173).
# Production should list only the game's origin.
SD_ALLOWED_ORIGINS=https://www.fullfran.com

# Headers PocketBase trusts for the client IP (rate limiting). Behind Traefik: X-Real-IP.
# Leave empty when the server is reachable without a proxy in front.
SD_TRUSTED_PROXY_HEADERS=X-Real-IP

# Built-in rate limiter; set to "off" to disable.
SD_RATE_LIMITS=on

# OAuth2 providers: each one is enabled only when both values are set.
# Redirect URL to register with each provider: https://sd-api.fullfran.com/api/oauth2-redirect
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email through Resend SMTP (verification, password reset, email change).
# SMTP is on only when SD_SMTP_HOST, SD_SMTP_PASSWORD and SD_MAIL_FROM_ADDRESS are all set.
# SD_SMTP_PASSWORD is a Resend API key with "Sending access" only; keep it in .env, never here.
SD_SMTP_HOST=smtp.resend.com
SD_SMTP_PORT=465
SD_SMTP_USERNAME=resend
SD_SMTP_PASSWORD=
# Default: true on port 465 (implicit TLS), false otherwise (STARTTLS on 587).
SD_SMTP_TLS=true
SD_MAIL_FROM_ADDRESS=no-reply@fullfran.com
SD_MAIL_FROM_NAME=Mazmorra Sombría
# Public API URL used in the email links (PocketBase confirmation pages under /_/).
SD_APP_URL=https://sd-api.fullfran.com
SD_APP_NAME=Mazmorra Sombría
